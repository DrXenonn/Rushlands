# ============================================
# Unity
# ============================================

# Generated by Unity (never commit these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should be committed. Do NOT ignore *.meta

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache / user files
.vs/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated project files
*.csproj
*.unityproj
*.sln
*.slnx

# Rider / VS Code
.idea/
.vscode/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Crashlytics generated file
crashlytics-build.properties

# Builds and packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables / Burst / generated caches
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/StreamingAssets/aa.meta
[Aa]ssets/StreamingAssets/aa/*
*.burst_debug_info
[Aa]ssets/Plugins/Android/**/*.aar.meta.tmp

# Gradle cache
.gradle/

# Test results
[Tt]est[Rr]esults/
TestResult*.xml

# ============================================
# Plastic SCM leftovers (old version control)
# ============================================
.plastic/
plastic.workspace
plastic.selector
plastic.wktree
plastic.changeset
ignore.conf
.plastic*
*.plastic

# ============================================
# Steamworks
# ============================================
# steam_appid.txt is intentionally NOT ignored (App ID 480 is the public Spacewar test ID).
# Do not commit the raw Steamworks SDK download:
[Ss]teamworks_[Ss][Dd][Kk]*/
sdk/
*.steamworks-sdk.zip

# ============================================
# Third-party / paid Asset Store packages
# ============================================
# Asset Store licenses forbid redistributing assets in public repos.
# Uncomment and edit the lines below for any paid asset you used,
# and list it in the README as a required package instead.
# Assets/SomePaidAsset/
# Assets/AnotherPaidAsset/

# ============================================
